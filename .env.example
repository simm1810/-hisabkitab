# Copy this file to .env and fill in your own Supabase project credentials.
# Find these at: Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# The Gemini API key for the "AI Suggest Near Me" feature is NOT set here.
# It must be set server-side as a Supabase Edge Function secret, so it's
# never exposed in the browser:
#
#   supabase functions deploy nearby-explorer
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key
